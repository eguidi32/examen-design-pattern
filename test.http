@walletHost = http://localhost:8080
@paymentHost = http://localhost:8081

### Seed wallets in badwallet-api
POST {{walletHost}}/api/wallets/seed?numWallets=10&eventsPerWallet=100

### Create wallet in badwallet-api
POST {{walletHost}}/api/wallets
Content-Type: application/json

{
  "phoneNumber": "+221779998877",
  "email": "testclient@gmail.com",
  "initialBalance": 25000,
  "code": "WLT-TEST001",
  "currency": "XOF"
}

### List wallets in badwallet-api
GET {{walletHost}}/api/wallets?page=0&size=10
Content-Type: application/json

### Get wallet by phone number in badwallet-api
GET {{walletHost}}/api/wallets/+221770000003
Content-Type: application/json

### Get wallet balance by phone number in badwallet-api
GET {{walletHost}}/api/wallets/+221770000003/balance
Content-Type: application/json

### Deposit into wallet in badwallet-api
POST {{walletHost}}/api/wallets/1/deposit
Content-Type: application/json

{
  "amount": 50000.00,
  "paymentMethod": "CREDIT_CARD"
}

### Withdraw from wallet in badwallet-api
POST {{walletHost}}/api/wallets/withdraw
Content-Type: application/json

{
  "phoneNumber": "+221770000001",
  "amount": 10000.00
}

### Transfer between wallets in badwallet-api
POST {{walletHost}}/api/wallets/transfer
Content-Type: application/json

{
  "senderPhone": "+221770000001",
  "receiverPhone": "+221770000002",
  "amount": 2000.00
}

### Seed factures in payment-service
POST {{paymentHost}}/api/factures/seed
Content-Type: application/json

### Get current unpaid factures in payment-service
GET {{paymentHost}}/api/factures/WLT-0000003/current
Content-Type: application/json

### Get current unpaid factures by unite in payment-service
GET {{paymentHost}}/api/factures/WLT-0000003/current?unite=WOYAFAL
Content-Type: application/json

### Get unpaid factures by period in payment-service
GET {{paymentHost}}/api/factures/WLT-0000003/periode?debut=2026-05-01&fin=2026-07-01
Content-Type: application/json

### Get current unpaid factures through badwallet-api proxy
GET {{walletHost}}/api/external/factures/WLT-0000003/current
Content-Type: application/json

### Get current unpaid factures by unite through badwallet-api proxy
GET {{walletHost}}/api/external/factures/WLT-0000003/current?unite=WOYAFAL
Content-Type: application/json

### Get unpaid factures by period through badwallet-api proxy
GET {{walletHost}}/api/external/factures/WLT-0000003/periode?debut=2026-05-01&fin=2026-07-01
Content-Type: application/json

### Pay current month facture in badwallet-api
POST {{walletHost}}/api/wallets/pay
Content-Type: application/json

{
  "phoneNumber": "+221770000003",
  "serviceName": "ISM",
  "amount": 5000.00
}

### Pay specific factures in badwallet-api
POST {{walletHost}}/api/wallets/pay-factures
Content-Type: application/json

{
  "phoneNumber": "+221770000003",
  "serviceName": "ISM",
  "factureReferences": ["FAC-ISM-3-1", "FAC-ISM-3-3"]
}
